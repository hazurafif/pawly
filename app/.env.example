# Pawly app configuration — copy to .env and adjust. All values are
# EXPO_PUBLIC_* (inlined into the app bundle, never secrets).

# Optional: pin the Pawly backend. When set, it is authoritative and used
# directly (health-checked); the LAN auto-detection scan is skipped.
# Example: http://192.168.1.50:8080
EXPO_PUBLIC_PAWLY_URL=

# Probe the local network for a Pawly server (GET /healthz) when no URL is
# configured above. Set to "false" to disable the scan.
EXPO_PUBLIC_PAWLY_AUTO_DETECT=true

# Port probed during auto-detection — matches the server's PAWLY_PORT.
EXPO_PUBLIC_PAWLY_PORT=8080
